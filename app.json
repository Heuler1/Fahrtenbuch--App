{
  "expo": {
    "name": "Oldtimer Fahrtenbuch",
    "slug": "oldtimer-fahrtenbuch",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "oldtimerfahrtenbuch",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "at.grobner.oldtimerfahrtenbuch",
      "buildNumber": "1"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Fotos für Fahrzeugbilder und Belege auswählen.",
          "cameraPermission": "Fahrzeugbilder und Belege fotografieren.",
          "microphonePermission": false
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "at.grobner.oldtimerfahrtenbuch",
      "versionCode": 1,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    }
  }
}
